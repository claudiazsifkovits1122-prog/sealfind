<Project Sdk="Microsoft.NET.Sdk">
  <!-- Führt die EditMode-Tests aus Assets/SealFind/Tests ohne Unity aus: dotnet test -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/SealFind/Scripts/Data/*.cs" />
    <Compile Include="../../../Assets/SealFind/Scripts/Generation/*.cs" />
    <Compile Include="../../../Assets/SealFind/Scripts/Gameplay/ScoreCalculator.cs" />
    <Compile Include="../../../Assets/SealFind/Scripts/Core/SaveSystem.cs" />
    <Compile Include="../../../Assets/SealFind/Tests/EditMode/*.cs" />
    <Compile Include="../Shim/*.cs" />
  </ItemGroup>
</Project>
