<Project Sdk="Microsoft.NET.Sdk">
  <!-- Rendert Wimmelbilder als PNG ohne Unity. Aufruf: siehe Program.cs -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>SEALFIND_ART_DUMP</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/SealFind/Scripts/Data/*.cs" />
    <Compile Include="../../../Assets/SealFind/Scripts/Generation/*.cs" />
    <Compile Include="../../../Assets/SealFind/Scripts/Art/*.cs" />
    <Compile Include="../Shim/*.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>
</Project>
